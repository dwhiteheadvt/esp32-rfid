// 1. Make sure LittleFS is included at the top of your file
#include <LittleFS.h>

void listLittleFSFilesRecursive(File dir, int depth = 0) {
    while (true) {
        File entry = dir.openNextFile();
        if (!entry) break;
        for (int i = 0; i < depth; i++) Serial.print("  ");
        if (entry.isDirectory()) {
            Serial.printf("DIR : %s\n", entry.name());
            listLittleFSFilesRecursive(entry, depth + 1);
        } else {
            Serial.printf("FILE: %s  SIZE: %d\n", entry.name(), entry.size());
        }
        entry.close();
    }
}

void listLittleFSFiles() {
    File root = LittleFS.open("/");
    Serial.println("--- LittleFS Directory Contents ---");
    listLittleFSFilesRecursive(root);
    Serial.println("-----------------------------------");
}

void setupWebServer() {
    listLittleFSFiles();

    server.addHandler(&ws);
    ws.onEvent(onWsEvent);

    if (config.httpPass == NULL) {
        config.httpPass = strdup("admin");
    }

    server.on("/login", HTTP_GET, [](AsyncWebServerRequest *request) {
        String remoteIP = printIP(request->client()->remoteIP());
        if (!request->authenticate(httpUsername, config.httpPass)) {
            return request->requestAuthentication();
        }
        request->send(200, "text/plain", "Success");
    });

    // Debug endpoint: lists all files in LittleFS
    // Access at http://<device-ip>/fsinfo
    server.on("/fsinfo", HTTP_GET, [](AsyncWebServerRequest *request) {
        String output = "{\n  \"files\": [\n";
        std::function<void(File, bool&)> listDir = [&](File dir, bool &first) {
            while (true) {
                File entry = dir.openNextFile();
                if (!entry) break;
                if (!first) output += ",\n";
                first = false;
                output += "    {\"name\":\"" + String(entry.name()) + "\",\"size\":" + String(entry.size()) + ",\"dir\":" + (entry.isDirectory() ? "true" : "false") + "}";
                if (entry.isDirectory()) listDir(entry, first);
                entry.close();
            }
        };
        File root = LittleFS.open("/");
        bool first = true;
        listDir(root, first);
        output += "\n  ],\n";
        output += "  \"totalBytes\":" + String(LittleFS.totalBytes()) + ",\n";
        output += "  \"usedBytes\":" + String(LittleFS.usedBytes()) + "\n}";
        request->send(200, "application/json", output);
    });

    server.on("/update", HTTP_POST, [](AsyncWebServerRequest *request) {
        AsyncWebServerResponse *response = request->beginResponse(200, "text/plain", shouldReboot ? "OK" : "FAIL");
        response->addHeader("Connection", "close");
        request->send(response);
    }, [](AsyncWebServerRequest *request, String filename, size_t index, uint8_t *data, size_t len, bool final) {
        if (!request->authenticate(httpUsername, config.httpPass)) {
            return;
        }
        if (!index) {
            if (!Update.begin((ESP.getFreeSketchSpace() - 0x1000) & 0xFFFFF000)) {
#ifdef DEBUG
                Update.printError(Serial);
#endif
            }
        }
        if (!Update.hasError()) {
            if (Update.write(data, len) != len) {
#ifdef DEBUG
                Update.printError(Serial);
#endif
            }
        }
        if (final) {
            if (Update.end(true)) {
#ifdef DEBUG
                Serial.printf("[ UPDT ] Firmware update finished: %uB\n", index + len);
#endif
                shouldReboot = !Update.hasError();
            } else {
#ifdef DEBUG
                Update.printError(Serial);
#endif
            }
        }
    });

    // Explicit handlers: check LittleFS first (serves customized files),
    // fall back to PROGMEM only when LittleFS doesn't have the file (first boot
    // before uploadfs, or emergency recovery).

    server.on("/fonts/glyphicons-halflings-regular.woff", HTTP_GET, [](AsyncWebServerRequest *request) {
        if (LittleFS.exists("/fonts/glyphicons-halflings-regular.woff")) {
            request->send(LittleFS, "/fonts/glyphicons-halflings-regular.woff", "font/woff");
        } else {
            AsyncWebServerResponse *response = request->beginResponse_P(200, "font/woff", glyphicons_halflings_regular_woff_gz, glyphicons_halflings_regular_woff_gz_len);
            response->addHeader("Content-Encoding", "gzip");
            request->send(response);
        }
    });
    server.on("/css/required.css", HTTP_GET, [](AsyncWebServerRequest *request) {
        if (LittleFS.exists("/css/required.css")) {
            request->send(LittleFS, "/css/required.css", "text/css");
        } else {
            AsyncWebServerResponse *response = request->beginResponse_P(200, "text/css", required_css_gz, required_css_gz_len);
            response->addHeader("Content-Encoding", "gzip");
            request->send(response);
        }
    });
    server.on("/js/required.js", HTTP_GET, [](AsyncWebServerRequest *request) {
        if (LittleFS.exists("/js/required.js")) {
            request->send(LittleFS, "/js/required.js", "text/javascript");
        } else {
            AsyncWebServerResponse *response = request->beginResponse_P(200, "text/javascript", required_js_gz, required_js_gz_len);
            response->addHeader("Content-Encoding", "gzip");
            request->send(response);
        }
    });
    server.on("/js/esprfid.js", HTTP_GET, [](AsyncWebServerRequest *request) {
        AsyncWebServerResponse *response;
        if (LittleFS.exists("/js/esprfid.js")) {
            response = request->beginResponse(LittleFS, "/js/esprfid.js", "text/javascript");
        } else {
            response = request->beginResponse_P(200, "text/javascript", esprfid_js_gz, esprfid_js_gz_len);
            response->addHeader("Content-Encoding", "gzip");
        }
        response->addHeader("Cache-Control", "no-cache, no-store, must-revalidate");
        request->send(response);
    });
    server.on("/js/boards.js", HTTP_GET, [](AsyncWebServerRequest *request) {
        if (LittleFS.exists("/js/boards.js")) {
            request->send(LittleFS, "/js/boards.js", "text/javascript");
        } else {
            AsyncWebServerResponse *response = request->beginResponse_P(200, "text/javascript", boards_js_gz, boards_js_gz_len);
            response->addHeader("Content-Encoding", "gzip");
            request->send(response);
        }
    });
    server.on("/index.html", HTTP_GET, [](AsyncWebServerRequest *request) {
        AsyncWebServerResponse *response;
        if (LittleFS.exists("/index.html")) {
            response = request->beginResponse(LittleFS, "/index.html", "text/html");
        } else {
            response = request->beginResponse_P(200, "text/html", index_html_gz, index_html_gz_len);
            response->addHeader("Content-Encoding", "gzip");
        }
        response->addHeader("Cache-Control", "no-cache, no-store, must-revalidate");
        request->send(response);
    });
    server.on("/esprfid.htm", HTTP_GET, [](AsyncWebServerRequest *request) {
        AsyncWebServerResponse *response;
        if (LittleFS.exists("/esprfid.htm")) {
            response = request->beginResponse(LittleFS, "/esprfid.htm", "text/html");
        } else {
            response = request->beginResponse_P(200, "text/html", esprfid_htm_gz, esprfid_htm_gz_len);
            response->addHeader("Content-Encoding", "gzip");
        }
        response->addHeader("Cache-Control", "no-cache, no-store, must-revalidate");
        request->send(response);
    });

    // Catch-all for any other LittleFS files (css, images, etc.)
    server.serveStatic("/", LittleFS, "/").setDefaultFile("index.html");

    server.rewrite("/", "/index.html");

    // 3. Catch-all 404 handler LAST
    server.onNotFound([](AsyncWebServerRequest *request) {
        request->send(404, "text/plain", "Not found");
    });

    server.begin();
#ifdef DEBUG
    Serial.println("[ INFO ] Webserver started");
#endif
}